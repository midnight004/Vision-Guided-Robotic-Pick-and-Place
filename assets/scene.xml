<mujoco model="factory_pick_and_place">
  <include file="franka/panda.xml"/>

  <compiler angle="radian" meshdir="franka/assets"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.3 0.3 0.3" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-20" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.15 0.15 0.15" width="512" height="512"/>
    <texture name="table_tex" type="2d" builtin="flat" rgb1="0.35 0.35 0.4" width="128" height="128"/>
    <texture name="belt_tex" type="2d" builtin="flat" rgb1="0.15 0.15 0.18" width="128" height="128"/>

    <material name="floor_mat" texture="floor_tex" texrepeat="10 10" specular="0.2" reflectance="0.2"/>
    <material name="table_mat" texture="table_tex" specular="0.3" shininess="0.5"/>
    <material name="belt_mat" texture="belt_tex" specular="0.1"/>
    <material name="metal" rgba="0.6 0.6 0.65 1" specular="0.8" shininess="0.9" reflectance="0.3"/>
    <material name="bin_red" rgba="0.75 0.12 0.1 1" specular="0.2"/>
    <material name="bin_blue" rgba="0.1 0.15 0.75 1" specular="0.2"/>
    <material name="bin_green" rgba="0.1 0.65 0.15 1" specular="0.2"/>
    <material name="bin_yellow" rgba="0.85 0.75 0.1 1" specular="0.2"/>
  </asset>

  <worldbody>
    <!-- Factory lighting (moderate to avoid overexposing object colors) -->
    <light name="ceiling1" pos="0.4 0 1.8" dir="0 0 -1" diffuse="0.45 0.45 0.45" specular="0.05 0.05 0.05" castshadow="true"/>
    <light name="ceiling2" pos="0.4 -0.5 1.5" dir="0 0.3 -1" diffuse="0.25 0.25 0.25" specular="0.0 0.0 0.0" castshadow="false"/>
    <light name="ceiling3" pos="0.4 0.5 1.5" dir="0 -0.3 -1" diffuse="0.25 0.25 0.25" specular="0.0 0.0 0.0" castshadow="false"/>

    <!-- Floor -->
    <geom name="floor" type="plane" size="3 3 0.01" material="floor_mat"/>

    <!-- Cameras -->
    <camera name="overhead_cam" pos="0.5 0 1.2" xyaxes="1 0 0 0 1 0" fovy="58"/>
    <camera name="side_cam" pos="1.0 -0.9 0.7" xyaxes="0.7 1 0 -0.2 0 1"/>
    <camera name="front_cam" pos="0.5 -0.8 0.6" xyaxes="1 0 0 0 0.4 1"/>

    <!-- ============ WORK TABLE ============ -->
    <body name="table" pos="0.5 0 0.28">
      <geom name="table_top" type="box" size="0.35 0.35 0.015" material="table_mat" mass="80"
            friction="0.8 0.01 0.001"/>
      <!-- Steel legs -->
      <geom type="cylinder" size="0.02 0.13" pos="0.28 0.28 -0.145" material="metal"/>
      <geom type="cylinder" size="0.02 0.13" pos="-0.28 0.28 -0.145" material="metal"/>
      <geom type="cylinder" size="0.02 0.13" pos="0.28 -0.28 -0.145" material="metal"/>
      <geom type="cylinder" size="0.02 0.13" pos="-0.28 -0.28 -0.145" material="metal"/>
    </body>

    <!-- ============ CONVEYOR BELT ============ -->
    <body name="conveyor" pos="0.5 -0.55 0.28">
      <!-- Belt surface (slightly below table for feeding) -->
      <geom name="belt_surface" type="box" size="0.35 0.08 0.008" material="belt_mat" mass="20"
            friction="0.5 0.005 0.001"/>
      <!-- Side rails -->
      <geom type="box" size="0.35 0.005 0.025" pos="0 0.075 0.02" material="metal"/>
      <geom type="box" size="0.35 0.005 0.025" pos="0 -0.075 0.02" material="metal"/>
      <!-- Support frame -->
      <geom type="cylinder" size="0.015 0.13" pos="0.3 0.06 -0.14" material="metal"/>
      <geom type="cylinder" size="0.015 0.13" pos="-0.3 0.06 -0.14" material="metal"/>
      <geom type="cylinder" size="0.015 0.13" pos="0.3 -0.06 -0.14" material="metal"/>
      <geom type="cylinder" size="0.015 0.13" pos="-0.3 -0.06 -0.14" material="metal"/>
      <!-- Roller ends (visual) -->
      <geom type="cylinder" size="0.025 0.07" pos="0.33 0 0" quat="0.707 0.707 0 0" material="metal" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.025 0.07" pos="-0.33 0 0" quat="0.707 0.707 0 0" material="metal" contype="0" conaffinity="0"/>
    </body>

    <!-- ============ SORTING BINS (on table edges) ============ -->
    <!-- Red bin (left edge) -->
    <body name="bin_red" pos="0.35 -0.28 0.30">
      <geom type="box" size="0.05 0.05 0.003" material="bin_red"/>
      <geom type="box" size="0.05 0.004 0.035" pos="0 0.046 0.035" material="bin_red"/>
      <geom type="box" size="0.05 0.004 0.035" pos="0 -0.046 0.035" material="bin_red"/>
      <geom type="box" size="0.004 0.05 0.035" pos="0.046 0 0.035" material="bin_red"/>
      <geom type="box" size="0.004 0.05 0.035" pos="-0.046 0 0.035" material="bin_red"/>
    </body>
    <!-- Blue bin (right edge) -->
    <body name="bin_blue" pos="0.35 0.28 0.30">
      <geom type="box" size="0.05 0.05 0.003" material="bin_blue"/>
      <geom type="box" size="0.05 0.004 0.035" pos="0 0.046 0.035" material="bin_blue"/>
      <geom type="box" size="0.05 0.004 0.035" pos="0 -0.046 0.035" material="bin_blue"/>
      <geom type="box" size="0.004 0.05 0.035" pos="0.046 0 0.035" material="bin_blue"/>
      <geom type="box" size="0.004 0.05 0.035" pos="-0.046 0 0.035" material="bin_blue"/>
    </body>
    <!-- Green bin (far left) -->
    <body name="bin_green" pos="0.6 -0.28 0.30">
      <geom type="box" size="0.05 0.05 0.003" material="bin_green"/>
      <geom type="box" size="0.05 0.004 0.035" pos="0 0.046 0.035" material="bin_green"/>
      <geom type="box" size="0.05 0.004 0.035" pos="0 -0.046 0.035" material="bin_green"/>
      <geom type="box" size="0.004 0.05 0.035" pos="0.046 0 0.035" material="bin_green"/>
      <geom type="box" size="0.004 0.05 0.035" pos="-0.046 0 0.035" material="bin_green"/>
    </body>
    <!-- Yellow bin (far right) -->
    <body name="bin_yellow" pos="0.6 0.28 0.30">
      <geom type="box" size="0.05 0.05 0.003" material="bin_yellow"/>
      <geom type="box" size="0.05 0.004 0.035" pos="0 0.046 0.035" material="bin_yellow"/>
      <geom type="box" size="0.05 0.004 0.035" pos="0 -0.046 0.035" material="bin_yellow"/>
      <geom type="box" size="0.004 0.05 0.035" pos="0.046 0 0.035" material="bin_yellow"/>
      <geom type="box" size="0.004 0.05 0.035" pos="-0.046 0 0.035" material="bin_yellow"/>
    </body>

    <!-- ============ PRODUCTS (8 varied items, factory-sized) ============ -->
    <!-- Red cube -->
    <body name="red_box" pos="0.4 -0.1 0.34">
      <joint name="red_box_joint" type="free"/>
      <geom name="red_box_geom" type="box" size="0.03 0.03 0.03" rgba="0.88 0.12 0.08 1" mass="0.05"
            condim="4" friction="1.5 0.01 0.001" solref="0.01 1" solimp="0.95 0.99 0.001"/>
    </body>
    <!-- Blue cube -->
    <body name="blue_box" pos="0.55 0.05 0.34">
      <joint name="blue_box_joint" type="free"/>
      <geom name="blue_box_geom" type="box" size="0.03 0.03 0.03" rgba="0.08 0.12 0.88 1" mass="0.05"
            condim="4" friction="1.5 0.01 0.001" solref="0.01 1" solimp="0.95 0.99 0.001"/>
    </body>
    <!-- Green cylinder (bottle-like) -->
    <body name="green_cylinder" pos="0.45 0.1 0.34">
      <joint name="green_cyl_joint" type="free"/>
      <geom name="green_cyl_geom" type="cylinder" size="0.025 0.035" rgba="0.08 0.78 0.12 1" mass="0.045"
            condim="4" friction="1.5 0.01 0.001" solref="0.01 1" solimp="0.95 0.99 0.001"/>
    </body>
    <!-- Yellow sphere (ball) -->
    <body name="yellow_sphere" pos="0.5 -0.05 0.34">
      <joint name="yellow_sph_joint" type="free"/>
      <geom name="yellow_sph_geom" type="sphere" size="0.03" rgba="0.95 0.82 0.08 1" mass="0.04"
            condim="4" friction="1.5 0.01 0.001" solref="0.01 1" solimp="0.95 0.99 0.001"/>
    </body>
    <!-- Red cylinder (can) -->
    <body name="red_can" pos="0.6 -0.1 0.34">
      <joint name="red_can_joint" type="free"/>
      <geom name="red_can_geom" type="cylinder" size="0.026 0.04" rgba="0.82 0.15 0.1 1" mass="0.05"
            condim="4" friction="1.5 0.01 0.001" solref="0.01 1" solimp="0.95 0.99 0.001"/>
    </body>
    <!-- Blue capsule (pill bottle) -->
    <body name="blue_capsule" pos="0.35 0.05 0.34">
      <joint name="blue_cap_joint" type="free"/>
      <geom name="blue_cap_geom" type="capsule" size="0.022 0.03" rgba="0.1 0.2 0.85 1" mass="0.04"
            condim="4" friction="1.5 0.01 0.001" solref="0.01 1" solimp="0.95 0.99 0.001"/>
    </body>
    <!-- Green box (package) -->
    <body name="green_box" pos="0.55 -0.15 0.34">
      <joint name="green_box_joint" type="free"/>
      <geom name="green_box_geom" type="box" size="0.032 0.026 0.022" rgba="0.12 0.72 0.18 1" mass="0.045"
            condim="4" friction="1.5 0.01 0.001" solref="0.01 1" solimp="0.95 0.99 0.001"/>
    </body>
    <!-- Yellow cylinder (small bottle) -->
    <body name="yellow_bottle" pos="0.4 0.15 0.34">
      <joint name="yellow_bot_joint" type="free"/>
      <geom name="yellow_bot_geom" type="cylinder" size="0.024 0.035" rgba="0.92 0.78 0.1 1" mass="0.04"
            condim="4" friction="1.5 0.01 0.001" solref="0.01 1" solimp="0.95 0.99 0.001"/>
    </body>

    <!-- EE grasp site (added to the hand for IK targeting) -->
    <frame name="grasp_site_frame" pos="0 0 0">
      <!-- This is a world-level frame, we'll reference the hand body directly -->
    </frame>
  </worldbody>

  <!-- Add a site to the hand for IK -->
  <sensor>
    <framepos name="ee_pos" objtype="body" objname="hand"/>
    <framequat name="ee_quat" objtype="body" objname="hand"/>
  </sensor>

  <keyframe>
    <key name="factory_home" qpos="0 0 0 -1.57079 0 1.57079 -0.7853 0.04 0.04
                            0.4 -0.1 0.33 1 0 0 0
                            0.55 0.05 0.33 1 0 0 0
                            0.45 0.1 0.33 1 0 0 0
                            0.5 -0.05 0.33 1 0 0 0
                            0.6 -0.1 0.33 1 0 0 0
                            0.35 0.05 0.33 1 0 0 0
                            0.55 -0.15 0.33 1 0 0 0
                            0.4 0.15 0.33 1 0 0 0"
         ctrl="0 0 0 -1.57079 0 1.57079 -0.7853 255"/>
  </keyframe>
</mujoco>
